# Local: `docker compose up -d` then use the default below.
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=matchday

# Shared secret for POST /api/revalidate and POST /api/sync.
REVALIDATE_SECRET=change-me

# Where `pnpm sync` sends its revalidation webhook (optional).
SITE_URL=http://localhost:3000
